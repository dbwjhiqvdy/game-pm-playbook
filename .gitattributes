# 换行符统一策略
# 仓库内统一用 LF 存储，避免 Windows / macOS / Linux 协作时出现"整个文件都改了"的假 diff
* text=auto eol=lf

# 二进制文件不做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.pptx binary
*.psd binary

# Windows 脚本保留 CRLF，避免部分工具解析异常
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
